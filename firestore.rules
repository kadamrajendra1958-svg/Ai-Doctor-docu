rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all access to any collections not explicitly specified
    match /{document=**} {
      allow read, write: if false;
    }

    // Users collection: Doctors can only access their own profile document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Patients collection: Doctors can only access patients assigned to them
    match /patients/{patientId} {
      // Must attach their own UID when creating a patient
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      // Can only read, update, or delete if the existing record belongs to them
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Consultations collection: Doctors can only access their own consultations
    match /consultations/{consultationId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
  }
}
